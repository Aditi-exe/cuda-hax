    WIDTH = screenwidth;
    HEIGHT = screenheight;

    float aspect_ratio = static_cast<float>(WIDTH) / static_cast<float>(HEIGHT);

    GLFWwindow *window = glfwCreateWindow(WIDTH, HEIGHT, "GPU-RTX", nullptr, nullptr);
